{
  "name": "pyxis-analytics",
  "version": "0.0.0",
  "description": "Privacy-first product analytics tracker for the browser: no cookies, no personal data, zero dependencies.",
  "keywords": [
    "analytics",
    "product-analytics",
    "privacy",
    "tracker",
    "lgpd",
    "gdpr",
    "zero-dependency"
  ],
  "homepage": "https://github.com/samuelcsantana/pyxis-sdk#readme",
  "bugs": {
    "url": "https://github.com/samuelcsantana/pyxis-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelcsantana/pyxis-sdk.git"
  },
  "license": "MIT",
  "author": "Samuel Santana",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "esbuild src/index.ts --bundle --minify --format=esm --target=es2020 --sourcemap --outfile=dist/index.js && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0 && node scripts/check-no-comments.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:tooling": "node --test \"eslint-rules/**/*.test.mjs\" \"scripts/**/*.test.mts\"",
    "size": "node scripts/check-size.mts",
    "prepare": "husky",
    "contract:sync": "node scripts/contract-sync.mts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,mts,mjs}": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "src/**/*.ts": "vitest related --run",
    "*.{json,yml,yaml,md}": "prettier --check"
  }
}
